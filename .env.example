# Copy to `.env` and fill in. `.env` is gitignored because the client secret belongs in it.
#
# Everything here is company-wide, never personal: TimeTac issues one client id/secret per company
# account, and the same pair works for every colleague. `make bundle` writes these into the app's
# Info.plist, so whoever you hand the build to only ever sees a username and password.
#
# Create the pair in TimeTac: Settings → API Credentials → Create. Note the expiry date you give
# it — once it lapses, sign-in fails as an invalid client until you build with a new pair.

TIMETAC_ACCOUNT       = yourcompany
TIMETAC_HOST          = api.timetac.com
TIMETAC_CLIENT_ID     =
TIMETAC_CLIENT_SECRET =

# Sign with a real identity rather than ad-hoc. An ad-hoc signature is regenerated on every build
# and the Keychain binds each item to the identity that wrote it, so ad-hoc builds re-prompt for
# Keychain access constantly. `make identities` lists what you have.
# CODESIGN_IDENTITY = Developer ID Application: You (TEAMID)

# Only needed for `make notarize`. Store the credentials once with:
#   xcrun notarytool store-credentials TimeTacBar \
#     --apple-id you@example.com --team-id TEAMID --password <app-specific-password>
# NOTARY_PROFILE = TimeTacBar
